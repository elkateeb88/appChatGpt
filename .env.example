# App Configuration
APP_NAME=AI Lead Generation Platform
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/leadgen_db

# Redis
REDIS_URL=redis://redis:6379

# OpenAI / LLM
OPENAI_API_KEY=sk-your-openai-api-key
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS=2000
TEMPERATURE=0.3

# Data Providers
CLEARBIT_API_KEY=your-clearbit-key
APOLLO_API_KEY=your-apollo-key
HUNTER_API_KEY=your-hunter-key
LUSHA_API_KEY=your-lusha-key

# Email Service Providers
# SendGrid
SENDGRID_API_KEY=your-sendgrid-key

# AWS SES
AWS_SES_ACCESS_KEY=your-aws-access-key
AWS_SES_SECRET_KEY=your-aws-secret-key
AWS_SES_REGION=us-east-1

# CRM Integrations
HUBSPOT_API_KEY=your-hubspot-key
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_DOMAIN=your-domain.my.salesforce.com

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
MAX_EMAILS_PER_DAY=500
EMAIL_SEND_DELAY_MIN=30
EMAIL_SEND_DELAY_MAX=90

# Lead Scoring
MIN_QUALIFICATION_SCORE=7
MAX_ENRICHMENT_ATTEMPTS=3

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
ENABLE_PROMETHEUS=True
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
