# ================================================
# Dental Booking Agent - Unified Environment Variables
# ================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# Application Settings
DEFAULT_LANGUAGE=ar
ENVIRONMENT=development
LOG_LEVEL=info

# Service Ports (internal Docker ports)
BACKEND_PORT=8001
DASHBOARD_PORT=3001
WHATSAPP_PORT=3002

# Internal Service URLs (for Docker network communication)
BACKEND_URL=http://backend:8001

# External URLs (for browser/external access)
NEXT_PUBLIC_API_URL=http://localhost:8001
